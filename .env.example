# NESTORA configuration.
# 1) Copy this file to ".env" in the project root (same folder as package.json).
#      PowerShell:  Copy-Item .env.example .env
#      macOS/Linux: cp .env.example .env
# 2) Replace every placeholder below with your own values. ".env" is git-ignored - never commit it
#    and never put real passwords or keys in this example file.
# The app and the npm db:* scripts read ".env" automatically (server/env.js).

# --- MySQL 8.0 (required; the primary database) ---
# Format: mysql://<host>:<port>/<database>   - NO user name or password inside the URL.
DATABASE_URL=mysql://localhost:3306/nestora_db
# A MySQL account that may use that database (for example the one you created, or "root" on a local dev machine).
DB_USERNAME=your_mysql_username
# Its password. Kept out of the URL so special characters like @ : / # need no escaping.
DB_PASSWORD=your_mysql_password

# --- Security ---
# Long random string used to sign login tokens (required when NODE_ENV=production).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- Server ---
PORT=3000

# --- AI complaint classification (optional) ---
# Leave empty to use the built-in keyword classifier. Get a key from your own Groq account.
GROQ_API_KEY=

# --- Optional tuning (uncomment to use) ---
# GROQ_MODEL=
# AI_TIMEOUT_MS=
# AI_MIN_CONFIDENCE=
# AI_MAX_CALLS_PER_MIN=
# NODE_ENV=production
# SEED_DEMO_DATA=false
